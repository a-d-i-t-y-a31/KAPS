{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "iVerilog: Build Current Testbench",
      "type": "shell",
      "command": "iverilog",
      "args": [
        "-g2012",
        "-o",
        "${workspaceFolder}/sim.out",
        "${file}",
        "${workspaceFolder}/KAPS.srcs/sources_1/new/*.v",
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "iVerilog: Run Simulation (vvp)",
      "type": "shell",
      "command": "vvp",
      "args": [
        "${workspaceFolder}/sim.out"
      ],
      "dependsOn": [
        "iVerilog: Build Current Testbench"
      ],
      "problemMatcher": []
    },
    {
      "label": "iVerilog: Build & Run All",
      "type": "shell",
      "command": "iverilog -g2012 -o sim.out ${workspaceFolder}/KAPS.srcs/sim_1/new/*.v ${workspaceFolder}/KAPS.srcs/sources_1/new/*.v && vvp sim.out",
      "problemMatcher": []
    },
    {
      "label": "GTKWave: Launch Waveform Viewer",
      "type": "shell",
      "command": "env -u LD_LIBRARY_PATH -u LD_PRELOAD gtkwave ${workspaceFolder}/dump.vcd",
      "problemMatcher": []
    }
  ]
}